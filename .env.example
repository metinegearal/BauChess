# Copy to .env. Never commit credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=chessDB
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=12
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
CHROMEDRIVER_PATH=/usr/bin/chromedriver
# Optional: Chrome/Chromium executable if Selenium cannot find it
CHROME_BINARY=
# Optional: stop at games on or before this date; blank scans latest ten
SCRAPE_AFTER_DATE=
# Relative paths resolve from the repository root
PEOPLE_FILE=people.txt
PGN_DATA_DIR=PgnData
OPENINGS_CSV=Data/openings.csv
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:12b
# Optional: browser/desktop viewer API address (public; do not put secrets in VITE_*).
VITE_API_URL=http://127.0.0.1:8000
